{
  "name": "stagebound",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stagebound-db",
      "database_id": "df1454eb-ca8c-4ead-bd47-1576b7356e17"
    }
  ],
  "vars": {
    "ACCESS_AUD": "40ac733081ecd757abb19dc65e97a1be049afdb772fc800504e32b08c5b98082",
    "ACCESS_TEAM_DOMAIN": "clearteck.cloudflareaccess.com"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "stagebound-photos"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "stagebound-backups"
    }
  ],
  "triggers": {
    "crons": [
      "0 8 * * *"
    ]
  }
}
